  <bpmn:process id="uc03-overbooking-saga" name="UC03 Overbooking Saga" isExecutable="true">
    <bpmn:documentation>UC03 - Saga de overbooking.

Equivalente en Camunda 8 de definitions/workflows/uc03-overbooking-workflow.yml.ec.

Toda la comunicacion con los workers va por eventos: cada paso es un subproceso
embebido que lanza un message throw event con el comando (uc03.&lt;paso&gt;.run) y se
queda esperando en un message catch event el evento de resultado
(uc03.&lt;paso&gt;.completed), correlacionado por reservationId.

Variable de entrada obligatoria: reservationId (es la correlation key).</bpmn:documentation>
    <bpmn:subProcess id="sp_setReservationOverbookingStatus" name="Reserva a OVERBOOKING_IN_PROGRESS">
      <bpmn:incoming>Flow_001</bpmn:incoming>
      <bpmn:outgoing>Flow_002</bpmn:outgoing>
      <bpmn:startEvent id="setReservationOverbookingStatus_start">
        <bpmn:outgoing>setReservationOverbookingStatus_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="setReservationOverbookingStatus_f1" sourceRef="setReservationOverbookingStatus_start" targetRef="setReservationOverbookingStatus_cmd" />
      <bpmn:intermediateThrowEvent id="setReservationOverbookingStatus_cmd" name="run">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="publish-event" retries="1" />
          <zeebe:taskHeaders>
            <zeebe:header key="eventName" value="uc03.setReservationOverbookingStatus.run" />
            <zeebe:header key="resultEventName" value="uc03.setReservationOverbookingStatus.completed" />
            <zeebe:header key="step" value="setReservationOverbookingStatus" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>setReservationOverbookingStatus_f1</bpmn:incoming>
        <bpmn:outgoing>setReservationOverbookingStatus_f2</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_cmd_setReservationOverbookingStatus" messageRef="Msg_cmd_setReservationOverbookingStatus" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="setReservationOverbookingStatus_f2" sourceRef="setReservationOverbookingStatus_cmd" targetRef="setReservationOverbookingStatus_res" />
      <bpmn:intermediateCatchEvent id="setReservationOverbookingStatus_res" name="done">
        <bpmn:incoming>setReservationOverbookingStatus_f2</bpmn:incoming>
        <bpmn:outgoing>setReservationOverbookingStatus_f3</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_res_setReservationOverbookingStatus" messageRef="Msg_res_setReservationOverbookingStatus" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="setReservationOverbookingStatus_f3" sourceRef="setReservationOverbookingStatus_res" targetRef="setReservationOverbookingStatus_end" />
      <bpmn:endEvent id="setReservationOverbookingStatus_end">
        <bpmn:incoming>setReservationOverbookingStatus_f3</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:subProcess id="sp_registerIncidence" name="Registrar incidencia en CRM">
