id: refund-payment
version: 1
group: pms-integration
topic: pms-integration
description: >-
  Devuelve en el folio de la reserva en Opera un cobro que recepción devolvió: el mismo pago en
  negativo, con el número de transacción del original y la referencia FO:PAY:<paymentId>:R.
  Idempotente. Si Opera aún no tiene el cobro, espera a que llegue (lo resuelve su post-payment);
  un rechazo es una causa.
input:
  hotelCode:
    type: string
    required: true
    description: el hotel del front office (código del CRS); el de Opera si la reserva nació en Opera
  locator:
    type: string
    required: true
    description: el localizador del CRS; la reserva de Opera si nació en Opera
  processKey:
    type: string
    required: true
  definitionId:
    type: string
    required: true
  pmsHotelCode:
    type: string
    required: true
    description: la propiedad de Opera
  pmsReservationId:
    type: string
    description: la reserva en Opera, si el front office la tiene enlazada; si no, se busca por el localizador
  stayId:
    type: string
    required: true
    description: la estancia del front office
  paymentId:
    type: string
    required: true
    description: el cobro del front office — la clave de idempotencia (FO:PAY:<paymentId>, la referencia del posteo en Opera)
  paymentKind:
    type: string
    description: PAYMENT o DEPOSIT (un anticipo)
  paymentMethod:
    type: string
    description: CASH, CARD_PINPAD, PAY_LINK, TRANSFER o MANUAL — la forma de pago de Opera sale de ella
  paymentReference:
    type: string
    description: la referencia del cobro en recepción (la autorización del datáfono…)
  amount:
    type: string
    required: true
    description: el importe cobrado, decimal («100.00»), positivo, en la moneda de la propiedad
  currency:
    type: string
    description: ISO 4217; ninguna, la de la propiedad
output:
  refundOutcome:
    type: string
    description: DONE, STALE (ya estaba devuelto, o Opera la tiene cancelada) o WAIT
  pmsReservationId:
    type: string
  pmsRefundId:
    type: string
    description: el número de transacción de la devolución en Opera
